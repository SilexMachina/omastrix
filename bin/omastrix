#!/usr/bin/env python3
"""OmaStrix host snapshot. Local sysfs only. Prints one JSON object."""

import glob
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import library
import webui

# Stock TTM pages_limit is about 16.3M pages (~62 GiB). A ceiling at or under
# this is the kernel default, not a Strix Halo raise.
STOCK_PAGES_LIMIT = 17_000_000
LIMINE_CONF = "/etc/limine-entry-tool.d/amd-gtt.conf"
MODPROBE_CONF = "/etc/modprobe.d/amd-gtt.conf"
# GiB label -> 4 KiB page count, and amdgpu.gttsize in MiB.
GTT_CHOICES = {
    "64": {"pages": 16_777_216, "gttsize": 65_536},
    "96": {"pages": 25_165_824, "gttsize": 98_304},
    "110": {"pages": 28_835_840, "gttsize": 112_640},
}


def read_text(path):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return ""


def read_int(path):
    text = read_text(path)
    try:
        return int(text)
    except ValueError:
        return None


def gib(n):
    if n is None:
        return None
    return round(n / 1024**3, 2)


def cmdline():
    return read_text("/proc/cmdline").split()


def pages_from_text(text):
    for part in text.split():
        if "ttm.pages_limit=" in part:
            raw = part.split("ttm.pages_limit=", 1)[1]
            raw = raw.split()[0].strip("\"'")
            try:
                return int(raw)
            except ValueError:
                return None
        if part.startswith("pages_limit="):
            try:
                return int(part.split("=", 1)[1])
            except ValueError:
                return None
    return None


def choice_for_pages(pages):
    if pages is None:
        return ""
    for label, spec in GTT_CHOICES.items():
        if spec["pages"] == pages:
            return label
    return ""


def configured_pages():
    # The boot files are the setting. Cmdline is what is live until reset.
    for path in (LIMINE_CONF, MODPROBE_CONF):
        pages = pages_from_text(read_text(path))
        if pages:
            return pages
    return pages_limit()


def file_bodies(label):
    spec = GTT_CHOICES[label]
    pages = spec["pages"]
    gttsize = spec["gttsize"]
    limine = (
        "# OmaStrix GTT ceiling: %s GiB.\n"
        "# pages_limit is 4 KiB pages.\n"
        "KERNEL_CMDLINE[default]+=\" ttm.pages_limit=%d ttm.page_pool_size=%d "
        "amdgpu.gttsize=%d amdgpu.vm_size=256\"\n"
    ) % (label, pages, pages, gttsize)
    modprobe = (
        "# OmaStrix GTT ceiling: %s GiB. vm_size is GPU VA space in GB, not a RAM steal.\n"
        "options ttm pages_limit=%d page_pool_size=%d\n"
        "options amdgpu gttsize=%d vm_size=256\n"
    ) % (label, pages, pages, gttsize)
    return limine, modprobe


def write_gtt(label):
    limine, modprobe = file_bodies(label)
    for path, body in ((LIMINE_CONF, limine), (MODPROBE_CONF, modprobe)):
        tmp = path + ".omastrix-tmp"
        with open(tmp, "w") as fh:
            fh.write(body)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    built = subprocess.run(["limine-mkinitcpio"], capture_output=True, text=True)
    if built.returncode != 0:
        err = (built.stderr or built.stdout or "limine-mkinitcpio failed").strip()
        print(json.dumps({"success": False, "error": err}))
        return 1
    print(json.dumps({"success": True, "gtt_set": label, "pending": True}))
    return 0


def pages_limit():
    for token in cmdline():
        if token.startswith("ttm.pages_limit="):
            try:
                return int(token.split("=", 1)[1])
            except ValueError:
                return None
    return None


def mem_total_bytes():
    for line in read_text("/proc/meminfo").splitlines():
        if line.startswith("MemTotal:"):
            return int(line.split()[1]) * 1024
    return None


def gpu_devices():
    found = []
    for path in sorted(glob.glob("/sys/class/drm/card*/device")):
        card = path.split("/sys/class/drm/")[1].split("/")[0]
        if "-" in card:
            continue
        if not os.path.exists(os.path.join(path, "mem_info_gtt_total")):
            continue
        found.append(path)
    return found


def lspci_name(slot):
    if not slot:
        return ""
    try:
        out = subprocess.run(
            ["lspci", "-nn", "-s", slot],
            capture_output=True,
            text=True,
            timeout=3,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    line = (out.stdout or "").strip().splitlines()
    return line[0] if line else ""


def is_strix_halo(pci, name):
    blob = (pci + " " + name).lower()
    if "strix halo" in blob or "strix_halo" in blob or "gfx1151" in blob:
        return True
    if any(token in blob for token in ("8060s", "8050s", "8040s")):
        return True
    # pci.ids names 1002:1586 as the Strix Halo display controller family.
    return "1002:1586" in blob.replace("0x", "")


def pill(used, total, default):
    if used is None or total is None:
        return "GTT ?"
    mark = "!" if default else ""
    return "%d/%dG%s" % (round(used), round(total), mark)


def snapshot():
    device = gpu_devices()[0] if gpu_devices() else ""
    uevent = {}
    if device:
        for line in read_text(os.path.join(device, "uevent")).splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                uevent[key] = value
    pci = (uevent.get("PCI_ID") or "").lower()
    slot = uevent.get("PCI_SLOT_NAME") or ""
    name = lspci_name(slot)
    gtt_total = read_int(os.path.join(device, "mem_info_gtt_total")) if device else None
    gtt_used = read_int(os.path.join(device, "mem_info_gtt_used")) if device else None
    limit = pages_limit()
    configured = configured_pages()
    choice = choice_for_pages(configured) or choice_for_pages(limit)
    live_choice = choice_for_pages(None)
    # Live ceiling matches a box when it is within half a GiB of that size.
    if gtt_total:
        for label in ("64", "96", "110"):
            if abs(gtt_total - int(label) * 1024**3) < 512 * 1024**2:
                live_choice = label
                break
    default = limit is None or limit <= STOCK_PAGES_LIMIT
    used_g = gib(gtt_used)
    total_g = gib(gtt_total)
    halo = bool(device) and is_strix_halo(pci, name)
    pending = bool(choice) and choice != live_choice
    lib = library.library_view(total_g)
    library.write_preset(total_g)
    pill_text = pill(used_g, total_g, default)
    if lib.get("loaded_short"):
        mark = "*" if lib.get("generating") else ""
        pill_text = "%s%s %s" % (lib["loaded_short"], mark, pill_text)
    return {
        "strix_halo": halo,
        "gpu_name": name,
        "pci": pci,
        "slot": slot,
        "driver": uevent.get("DRIVER") or "",
        "gtt_used_gib": used_g,
        "gtt_total_gib": total_g,
        "gtt_default": default,
        "gtt_set": choice,
        "gtt_live": live_choice,
        "gtt_pending": pending,
        "pages_limit": limit,
        "mem_total_gib": gib(mem_total_bytes()),
        "pill": pill_text,
        "vertical": "GTT" if halo else "?",
        "engine": engine_info(),
        "webui": webui_info(),
        "library": lib,
    }


def webui_info():
    return webui.status()


def engine_paths():
    home = os.path.expanduser("~")
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    return {
        "bin": os.path.join(home, ".local/share/omastrix/bin/llama-server"),
        "record": os.path.join(home, ".config/omastrix/engine.json"),
        "pin": os.path.join(root, "engine-pin.json"),
        "unit": "omastrix-llama.service",
        "ui": "http://127.0.0.1:8080",
    }


def systemctl(*args):
    try:
        out = subprocess.run(
            ["systemctl", "--user", *args],
            capture_output=True, text=True, timeout=15, check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 1, str(exc)
    text = (out.stdout or out.stderr or "").strip()
    return out.returncode, text


def port_open():
    try:
        out = subprocess.run(["ss", "-ltn"], capture_output=True, text=True, timeout=3, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return any(line.split()[3].endswith(":8080") for line in (out.stdout or "").splitlines() if line.split())


def engine_info():
    paths = engine_paths()
    record = {}
    if os.path.exists(paths["record"]):
        try:
            with open(paths["record"]) as fh:
                record = json.load(fh)
        except (OSError, json.JSONDecodeError):
            record = {}
    pin = {}
    if os.path.exists(paths["pin"]):
        try:
            with open(paths["pin"]) as fh:
                pin = json.load(fh)
        except (OSError, json.JSONDecodeError):
            pin = {}
    installed = os.path.isfile(paths["bin"]) and os.access(paths["bin"], os.X_OK)
    active, active_text = systemctl("is-active", paths["unit"])
    enabled, enabled_text = systemctl("is-enabled", paths["unit"])
    state = active_text or "inactive"
    if state == "active":
        state = "running"
    elif state == "activating":
        state = "starting"
    elif state == "failed":
        state = "failed"
    else:
        state = "stopped"
    listening = port_open()
    return {
        "installed": installed,
        "version": record.get("version") or "",
        "commit": record.get("commit") or "",
        "pin": pin.get("commit") or "",
        "state": state if installed else "not_installed",
        "autostart": enabled_text == "enabled",
        "listening": listening,
        "ui": paths["ui"],
    }


def engine_action(verb, arg):
    paths = engine_paths()
    if verb == "engine-start":
        code, text = systemctl("start", paths["unit"])
        print(json.dumps({"success": code == 0, "error": "" if code == 0 else text}))
        return 0 if code == 0 else 1
    if verb == "engine-stop":
        code, text = systemctl("stop", paths["unit"])
        print(json.dumps({"success": code == 0, "error": "" if code == 0 else text}))
        return 0 if code == 0 else 1
    if verb == "engine-autostart":
        if arg not in ("on", "off"):
            print("engine-autostart needs on or off", file=sys.stderr)
            return 2
        code, text = systemctl("enable" if arg == "on" else "disable", paths["unit"])
        print(json.dumps({"success": code == 0, "autostart": arg == "on", "error": "" if code == 0 else text}))
        return 0 if code == 0 else 1
    if verb == "engine-check":
        info = engine_info()
        latest = ""
        try:
            remote = subprocess.run(
                ["git", "ls-remote", "--tags", "https://github.com/halo-box/strix-llama.cpp.git"],
                capture_output=True, text=True, timeout=20, check=False,
            )
            tags = []
            for line in (remote.stdout or "").splitlines():
                if "refs/tags/" not in line or "^{}" in line:
                    continue
                name = line.split("refs/tags/")[-1]
                if len(name) > 1 and name[0] == "b" and name[1:].isdigit():
                    tags.append((int(name[1:]), name))
            if tags:
                latest = max(tags)[1]
        except (OSError, subprocess.TimeoutExpired):
            latest = ""
        info["latest_tag"] = latest
        info["matches_pin"] = bool(info["commit"]) and info["commit"] == info["pin"]
        print(json.dumps(info))
        return 0
    print("unknown verb: %s" % verb, file=sys.stderr)
    return 2


def main():
    verb = sys.argv[1] if len(sys.argv) > 1 else "snapshot"
    if verb in ("snapshot", "status"):
        print(json.dumps(snapshot(), separators=(",", ":")))
        return 0
    if verb == "set-gtt":
        if len(sys.argv) < 3 or sys.argv[2] not in GTT_CHOICES:
            print("set-gtt needs 64, 96, or 110", file=sys.stderr)
            return 2
        label = sys.argv[2]
        if "--print" in sys.argv:
            limine, modprobe = file_bodies(label)
            print(json.dumps({"limine": limine, "modprobe": modprobe}))
            return 0
        if os.geteuid() != 0:
            os.execvp("pkexec", ["pkexec", os.path.abspath(__file__), "set-gtt", label])
        return write_gtt(label)
    if verb in ("engine-start", "engine-stop", "engine-autostart", "engine-check"):
        arg = sys.argv[2] if len(sys.argv) > 2 else ""
        return engine_action(verb, arg)
    if verb == "library-fetch":
        return library.fetch(sys.argv[2] if len(sys.argv) > 2 else "")
    if verb == "library-download":
        print(json.dumps(library.start_download(sys.argv[2] if len(sys.argv) > 2 else "")))
        return 0
    if verb == "library-load":
        model_id = sys.argv[2] if len(sys.argv) > 2 else ""
        confirm = "--confirm" in sys.argv
        snap = snapshot()
        print(json.dumps(library.load_checked(model_id, snap.get("gtt_total_gib"), confirm)))
        return 0
    if verb == "library-unload":
        print(json.dumps(library.unload_model(sys.argv[2] if len(sys.argv) > 2 else "")))
        return 0
    if verb == "library-delete":
        model_id = sys.argv[2] if len(sys.argv) > 2 else ""
        confirm = "--confirm" in sys.argv
        snap = snapshot()
        print(json.dumps(library.delete_model(model_id, snap.get("gtt_total_gib"), confirm)))
        return 0
    if verb == "webui-install-run":
        return webui.install()
    if verb == "webui-install":
        print(json.dumps(webui.start_install()))
        return 0
    if verb == "webui-start":
        print(json.dumps(webui.start()))
        return 0
    if verb == "webui-stop":
        print(json.dumps(webui.stop()))
        return 0
    print("unknown verb: %s" % verb, file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
